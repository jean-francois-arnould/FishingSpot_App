@page "/statistiques"
@page "/FishingSpot_App/statistiques"
@using FishingSpot.PWA.Models
@using FishingSpot.PWA.Services
@using System.Globalization
@inject IStatisticsService StatisticsService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Statistiques</PageTitle>

<AuthorizeView>
    <div class="page-content stats-page stats-dashboard">
        @if (isLoading)
        {
            <div class="empty-state">
                <div class="spinner"></div>
                <p class="mt-3">Chargement des statistiques...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="empty-state">
                <div class="empty-state-icon fs-icon-stats" aria-hidden="true"></div>
                <h3>Statistiques indisponibles</h3>
                <p class="text-muted">@loadError</p>
            </div>
        }
        else if (dashboard == null || dashboard.TotalAvailableCatches == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon fs-icon-stats" aria-hidden="true"></div>
                <h3>Aucune statistique disponible</h3>
                <p class="text-muted">Commencez par enregistrer vos prises pour voir vos statistiques.</p>
            </div>
        }
        else
        {
            var stats = dashboard.Summary;
            var maxSpeciesCount = dashboard.SpeciesBreakdown.Any() ? dashboard.SpeciesBreakdown.Max(s => s.Count) : 0;
            var maxMonthlyCount = dashboard.MonthlyTrends.Any() ? dashboard.MonthlyTrends.Max(m => m.Count) : 0;
            var maxHourlyCount = dashboard.HourlyBreakdown.Any() ? dashboard.HourlyBreakdown.Max(h => h.Count) : 0;
            var insights = dashboard.AdvancedInsights;

            <section class="stats-hero">
                <div class="stats-hero-copy">
                    <span class="stats-eyebrow">Tableau de bord</span>
                    <h1>Conditions gagnantes</h1>
                    <p>@dashboard.PeriodLabel - @FormatDateRange()</p>
                </div>

                <div class="stats-period-tabs" aria-label="Filtrer la période">
                    @foreach (var option in periodOptions)
                    {
                        <button type="button"
                                class="period-tab @(selectedPeriod == option.Period ? "active" : "")"
                                @onclick="() => ChangePeriod(option.Period)">
                            @option.Label
                        </button>
                    }
                </div>
            </section>

            @if (stats.TotalCatches == 0)
            {
                <div class="empty-state stats-period-empty">
                    <div class="empty-state-icon fs-icon-calendar" aria-hidden="true"></div>
                    <h3>Aucune prise sur cette période</h3>
                    <p class="text-muted">Changez la période pour retrouver vos prises plus anciennes.</p>
                </div>
            }
            else
            {
                <section class="stats-kpi-grid" aria-label="Résumé des statistiques">
                    <article class="stats-kpi-card">
                        <span class="kpi-label">Prises</span>
                        <strong>@stats.TotalCatches</strong>
                        <small>@stats.TotalSpecies espèce@(stats.TotalSpecies > 1 ? "s" : "")</small>
                    </article>
                    <article class="stats-kpi-card">
                        <span class="kpi-label">Poids total</span>
                        <strong>@FormatKg(stats.TotalWeight)</strong>
                        <small>Moyenne @FormatKg(stats.AverageWeight)</small>
                    </article>
                    <article class="stats-kpi-card">
                        <span class="kpi-label">Taille moyenne</span>
                        <strong>@FormatCm(stats.AverageLength)</strong>
                        <small>@FormatBestCatch(stats.BiggestCatch, "Record longueur")</small>
                    </article>
                    <article class="stats-kpi-card">
                        <span class="kpi-label">Plus lourd</span>
                        <strong>@FormatKg(stats.HeaviestCatch?.Weight ?? 0)</strong>
                        <small>@(stats.HeaviestCatch?.FishName ?? "Aucune prise")</small>
                    </article>
                </section>

                <section class="stats-insight-grid">
                    <article class="stats-panel conditions-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Analyse conditions</span>
                                <h2>Ce qui marche le mieux</h2>
                            </div>
                        </div>

                        <div class="conditions-grid">
                            <div class="condition-card condition-card-primary">
                                <span>Plage horaire</span>
                                <strong>@dashboard.Conditions.BestTimeSlot</strong>
                                <small>@CountLabel(dashboard.Conditions.BestTimeSlotCount)</small>
                            </div>
                            <div class="condition-card">
                                <span>Météo</span>
                                <strong>@dashboard.Conditions.BestWeatherCondition</strong>
                                <small>@CountLabel(dashboard.Conditions.BestWeatherCount)</small>
                            </div>
                            <div class="condition-card">
                                <span>Température</span>
                                <strong>@FormatNullable(dashboard.Conditions.AverageTemperature, "0.0", "°C")</strong>
                                <small>@dashboard.Conditions.WeatherSampleCount relevé@(dashboard.Conditions.WeatherSampleCount > 1 ? "s" : "")</small>
                            </div>
                            <div class="condition-card">
                                <span>Vent</span>
                                <strong>@FormatNullable(dashboard.Conditions.AverageWindSpeed, "0.0", "km/h")</strong>
                                <small>moyenne des prises</small>
                            </div>
                            <div class="condition-card">
                                <span>Humidité</span>
                                <strong>@FormatNullable(dashboard.Conditions.AverageHumidity, "0", "%")</strong>
                                <small>moyenne relevée</small>
                            </div>
                            <div class="condition-card">
                                <span>Lieu</span>
                                <strong>@(dashboard.Conditions.BestLocation?.LocationName ?? "Non renseigné")</strong>
                                <small>@CountLabel(dashboard.Conditions.BestLocation?.Count ?? 0)</small>
                            </div>
                        </div>

                        @if (!dashboard.WeatherBreakdown.Any())
                        {
                            <p class="stats-muted-note">Ajoutez les données météo sur vos prochaines prises pour obtenir une lecture plus précise des conditions gagnantes.</p>
                        }
                    </article>

                    <article class="stats-panel records-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Records</span>
                                <h2>Prises marquantes</h2>
                            </div>
                        </div>

                        <div class="record-stack">
                            @if (stats.BiggestCatch != null)
                            {
                                <button type="button" class="record-row" @onclick="() => NavigateToCatchDetail(stats.BiggestCatch.Id)">
                                    @CatchThumb(stats.BiggestCatch)
                                    <span>
                                        <strong>@stats.BiggestCatch.FishName</strong>
                                        <small>@FormatCm(stats.BiggestCatch.Length) - @stats.BiggestCatch.CatchDate.ToString("dd/MM/yyyy")</small>
                                    </span>
                                    <span class="record-metric">Longueur</span>
                                </button>
                            }
                            @if (stats.HeaviestCatch != null)
                            {
                                <button type="button" class="record-row" @onclick="() => NavigateToCatchDetail(stats.HeaviestCatch.Id)">
                                    @CatchThumb(stats.HeaviestCatch)
                                    <span>
                                        <strong>@stats.HeaviestCatch.FishName</strong>
                                        <small>@FormatKg(stats.HeaviestCatch.Weight) - @stats.HeaviestCatch.CatchDate.ToString("dd/MM/yyyy")</small>
                                    </span>
                                    <span class="record-metric">Poids</span>
                                </button>
                            }
                        </div>
                    </article>
                </section>

                @if (insights.ReturnSuggestions.Any())
                {
                    <section class="stats-panel suggestions-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Suggestion automatique</span>
                                <h2>Meilleur moment pour retourner</h2>
                            </div>
                        </div>

                        <div class="suggestion-grid">
                            @foreach (var suggestion in insights.ReturnSuggestions)
                            {
                                <article class="suggestion-card">
                                    <div>
                                        <strong>@suggestion.SpotName</strong>
                                        <small>@FormatSuggestionDate(suggestion.SuggestedAt) - @suggestion.TimeSlot</small>
                                    </div>
                                    <p>@suggestion.Reason</p>
                                    <span>@suggestion.WeatherSummary</span>
                                    <em>@suggestion.ConfidenceScore.ToString("0", CultureInfo.CurrentCulture)/100 @(suggestion.UsesForecast ? "avec meteo" : "historique")</em>
                                </article>
                            }
                        </div>
                    </section>
                }

                <section class="stats-grid-two">
                    <article class="stats-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Montages</span>
                                <h2>Setup le plus efficace</h2>
                            </div>
                        </div>

                        @if (insights.SetupEfficiency.Any())
                        {
                            <div class="setup-efficiency-list">
                                @foreach (var setup in insights.SetupEfficiency.Take(5))
                                {
                                    <button type="button" class="setup-efficiency-row" @onclick="() => NavigateToCatchDetail(setup.BestCatch?.Id ?? 0)" disabled="@(setup.BestCatch == null)">
                                        <span>
                                            <strong>@setup.SetupName</strong>
                                            <small>@setup.Count prise@(setup.Count > 1 ? "s" : "") - @setup.SpeciesCount espece@(setup.SpeciesCount > 1 ? "s" : "") - moy. @FormatCm(setup.AverageLength)</small>
                                        </span>
                                        <em>@setup.EfficiencyScore.ToString("0", CultureInfo.CurrentCulture)</em>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="stats-muted-note">Associez vos prochaines prises a un montage pour comparer les setups.</p>
                        }
                    </article>

                    <article class="stats-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Score session</span>
                                <h2>Sessions les mieux notees</h2>
                            </div>
                        </div>

                        @if (insights.SessionScores.Any())
                        {
                            <div class="session-score-list">
                                @foreach (var session in insights.SessionScores.Take(5))
                                {
                                    <button type="button" class="session-score-row" @onclick="() => NavigateToCatchDetail(session.CatchId)">
                                        @CatchThumb(session.Catch)
                                        <span>
                                            <strong>@session.Catch.FishName</strong>
                                            <small>@session.PrimaryReason - @session.Catch.CatchDate.ToString("dd/MM/yyyy")</small>
                                        </span>
                                        <em>@session.Grade<br />@session.Score.ToString("0", CultureInfo.CurrentCulture)</em>
                                    </button>
                                }
                            </div>
                        }
                    </article>
                </section>

                @if (insights.SpeciesRecords.Any())
                {
                    <section class="stats-panel species-records-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Records personnels</span>
                                <h2>Galerie par espece</h2>
                            </div>
                        </div>

                        <div class="species-record-grid">
                            @foreach (var record in insights.SpeciesRecords.Take(12))
                            {
                                <button type="button" class="species-record-card" @onclick="() => NavigateToCatchDetail(record.Catch.Id)">
                                    @if (!string.IsNullOrWhiteSpace(record.PhotoUrl))
                                    {
                                        <img src="@record.PhotoUrl" alt="@record.FishName" />
                                    }
                                    else
                                    {
                                        <span class="catch-preview-icon fs-icon-catches" aria-hidden="true"></span>
                                    }
                                    <strong>@record.FishName</strong>
                                    <small>@FormatCm(record.Length) - @FormatKg(record.Weight)</small>
                                </button>
                            }
                        </div>
                    </section>
                }

                <section class="stats-grid-two">
                    <article class="stats-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Espèces</span>
                                <h2>Répartition des prises</h2>
                            </div>
                        </div>

                        <div class="stats-bar-list">
                            @foreach (var species in dashboard.SpeciesBreakdown.Take(8))
                            {
                                <div class="stats-bar-row">
                                    <div class="bar-meta">
                                        <span>@species.FishName</span>
                                        <strong>@species.Count</strong>
                                    </div>
                                    <div class="bar-track" aria-hidden="true">
                                        <span style="@BarWidthStyle(species.Count, maxSpeciesCount)"></span>
                                    </div>
                                    <small>Moy. @FormatCm(species.AverageLength) - @FormatKg(species.TotalWeight) total</small>
                                </div>
                            }
                        </div>
                    </article>

                    <article class="stats-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Horaires</span>
                                <h2>Activité par heure</h2>
                            </div>
                        </div>

                        <div class="hour-heatmap" aria-label="Prises par heure">
                            @foreach (var hour in dashboard.HourlyBreakdown)
                            {
                                <div class="hour-cell @(hour.Count > 0 ? "active" : "")"
                                     style="@HeatStyle(hour.Count, maxHourlyCount)"
                                     title="@($"{hour.Label}: {CountLabel(hour.Count)}")">
                                    <span>@hour.Label</span>
                                    <strong>@hour.Count</strong>
                                </div>
                            }
                        </div>
                    </article>
                </section>

                <section class="stats-grid-two">
                    <article class="stats-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Tendance</span>
                                <h2>Évolution mensuelle</h2>
                            </div>
                        </div>

                        @if (dashboard.MonthlyTrends.Any())
                        {
                            <div class="monthly-bars">
                                @foreach (var trend in dashboard.MonthlyTrends.TakeLast(12))
                                {
                                    <div class="monthly-column">
                                        <span class="monthly-count">@trend.Count</span>
                                        <div class="monthly-track">
                                            <span style="@BarHeightStyle(trend.Count, maxMonthlyCount)"></span>
                                        </div>
                                        <small>@FormatMonth(trend)</small>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="stats-muted-note">Pas encore assez de données pour dessiner une tendance mensuelle.</p>
                        }
                    </article>

                    <article class="stats-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Lieux</span>
                                <h2>Spots productifs</h2>
                            </div>
                        </div>

                        @if (dashboard.TopLocations.Any())
                        {
                            <div class="location-rank-list">
                                @foreach (var location in dashboard.TopLocations)
                                {
                                    <div class="location-rank-row">
                                        <span>
                                            <strong>@location.LocationName</strong>
                                            <small>@FormatCm(location.AverageSize) moyen</small>
                                        </span>
                                        <em>@CountLabel(location.Count)</em>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="stats-muted-note">Renseignez les lieux sur vos prises pour comparer vos spots.</p>
                        }
                    </article>
                </section>

                @if (dashboard.WeatherBreakdown.Any())
                {
                    <section class="stats-panel weather-panel">
                        <div class="stats-panel-header">
                            <div>
                                <span class="stats-eyebrow">Météo</span>
                                <h2>Conditions observées</h2>
                            </div>
                        </div>

                        <div class="weather-chip-grid">
                            @foreach (var weather in dashboard.WeatherBreakdown.Take(6))
                            {
                                <div class="weather-chip">
                                    <span class="weather-chip-icon">@GetWeatherEmoji(weather.WeatherCode ?? 0)</span>
                                    <span>
                                        <strong>@weather.Condition</strong>
                                        <small>@CountLabel(weather.Count) - @FormatNullable(weather.AverageTemperature, "0.0", "°C")</small>
                                    </span>
                                </div>
                            }
                        </div>
                    </section>
                }

                <section class="calendar-section stats-calendar-panel">
                    <div class="calendar-header">
                        <button class="calendar-nav-btn" @onclick="PreviousMonth" aria-label="Mois précédent">‹</button>
                        <h3 class="calendar-title">@currentMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</h3>
                        <button class="calendar-nav-btn" @onclick="NextMonth" aria-label="Mois suivant">›</button>
                    </div>

                    <div class="calendar-grid">
                        <div class="calendar-day-name">Lun</div>
                        <div class="calendar-day-name">Mar</div>
                        <div class="calendar-day-name">Mer</div>
                        <div class="calendar-day-name">Jeu</div>
                        <div class="calendar-day-name">Ven</div>
                        <div class="calendar-day-name">Sam</div>
                        <div class="calendar-day-name">Dim</div>

                        @for (int i = 0; i < firstDayOfMonth; i++)
                        {
                            <div class="calendar-day calendar-day-empty"></div>
                        }

                        @for (int day = 1; day <= daysInMonth; day++)
                        {
                            var currentDate = new DateTime(currentMonth.Year, currentMonth.Month, day);
                            var catchesOnDate = GetCatchesForDate(currentDate);
                            var hasCatch = catchesOnDate.Any();
                            var isToday = currentDate.Date == DateTime.Today;

                            <button type="button"
                                    class="calendar-day @(hasCatch ? "has-catch" : "") @(isToday ? "is-today" : "")"
                                    @onclick="() => ShowCatchesForDate(currentDate, catchesOnDate)"
                                    disabled="@(!hasCatch)">
                                <span class="calendar-day-number">@day</span>
                                @if (hasCatch)
                                {
                                    <span class="calendar-day-badge">@catchesOnDate.Count</span>
                                }
                            </button>
                        }
                    </div>
                </section>
            }
        }
    </div>
</AuthorizeView>

@if (showCatchesModal && selectedDateCatches != null && selectedDateCatches.Any())
{
    <div class="stat-modal-overlay" @onclick="CloseCatchesModal">
        <div class="stat-modal-dialog catches-modal-dialog" @onclick:stopPropagation>
            <div class="stat-modal-icon fs-icon-stats" aria-hidden="true"></div>
            <h3 class="stat-modal-title">Prises du @selectedDate.ToString("dd/MM/yyyy")</h3>

            <div class="catches-modal-list">
                @foreach (var fishCatch in selectedDateCatches)
                {
                    <button type="button" class="catch-preview-card" @onclick="() => NavigateToCatchDetail(fishCatch.Id)">
                        <div class="catch-preview-header">
                            @CatchThumb(fishCatch)
                            <div class="catch-preview-info">
                                <div class="catch-preview-name">@fishCatch.FishName</div>
                                <div class="catch-preview-location">@(!string.IsNullOrWhiteSpace(fishCatch.LocationName) ? fishCatch.LocationName : "Lieu non renseigné")</div>
                            </div>
                            <div class="catch-preview-arrow">›</div>
                        </div>
                        <div class="catch-preview-stats">
                            <span class="catch-preview-badge">@FormatCm(fishCatch.Length)</span>
                            <span class="catch-preview-badge">@FormatKg(fishCatch.Weight)</span>
                            @if (fishCatch.WeatherTemperature.HasValue)
                            {
                                <span class="catch-preview-badge">@GetWeatherEmoji(fishCatch.WeatherCode ?? 0) @fishCatch.WeatherTemperature.Value.ToString("0.0", CultureInfo.CurrentCulture)°C</span>
                            }
                        </div>
                    </button>
                }
            </div>

            <button class="stat-modal-button" @onclick="CloseCatchesModal">OK</button>
        </div>
    </div>
}

@code {
    private StatisticsDashboard? dashboard;
    private StatisticsPeriod selectedPeriod = StatisticsPeriod.Last90Days;
    private bool isLoading = true;
    private string? loadError;

    private readonly List<PeriodOption> periodOptions = new()
    {
        new PeriodOption { Period = StatisticsPeriod.Last30Days, Label = "30 jours" },
        new PeriodOption { Period = StatisticsPeriod.Last90Days, Label = "90 jours" },
        new PeriodOption { Period = StatisticsPeriod.CurrentYear, Label = "Année" },
        new PeriodOption { Period = StatisticsPeriod.AllTime, Label = "Tout" }
    };

    private DateTime currentMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private int daysInMonth => DateTime.DaysInMonth(currentMonth.Year, currentMonth.Month);
    private int firstDayOfMonth
    {
        get
        {
            var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);
            var dayOfWeek = (int)firstDay.DayOfWeek;
            return dayOfWeek == 0 ? 6 : dayOfWeek - 1;
        }
    }

    private bool showCatchesModal;
    private DateTime selectedDate;
    private List<FishCatch>? selectedDateCatches;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/FishingSpot_App/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;

        try
        {
            dashboard = await StatisticsService.GetDashboardAsync(selectedPeriod);
            AlignCalendarToLatestCatch();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des statistiques : {ex.Message}");
            loadError = "Impossible de charger les statistiques pour le moment.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangePeriod(StatisticsPeriod period)
    {
        if (selectedPeriod == period || isLoading)
            return;

        selectedPeriod = period;
        await LoadData();
    }

    private void AlignCalendarToLatestCatch()
    {
        var latestCatch = dashboard?.Catches
            .OrderByDescending(c => c.CatchDate)
            .FirstOrDefault();

        currentMonth = latestCatch == null
            ? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1)
            : new DateTime(latestCatch.CatchDate.Year, latestCatch.CatchDate.Month, 1);
    }

    private List<FishCatch> GetCatchesForDate(DateTime date)
    {
        if (dashboard == null)
            return new List<FishCatch>();

        return dashboard.Catches
            .Where(c => c.CatchDate.Date == date.Date)
            .OrderBy(c => c.CatchTime ?? TimeSpan.Zero)
            .ToList();
    }

    private void PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
    }

    private void NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
    }

    private void ShowCatchesForDate(DateTime date, List<FishCatch> catches)
    {
        if (!catches.Any())
            return;

        selectedDate = date;
        selectedDateCatches = catches;
        showCatchesModal = true;
    }

    private void CloseCatchesModal()
    {
        showCatchesModal = false;
        selectedDateCatches = null;
    }

    private void NavigateToCatchDetail(int catchId)
    {
        if (catchId <= 0)
            return;

        Navigation.NavigateTo($"/FishingSpot_App/catches/{catchId}");
    }

    private RenderFragment CatchThumb(FishCatch fishCatch) => builder =>
    {
        if (!string.IsNullOrWhiteSpace(fishCatch.PhotoUrl))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "src", fishCatch.PhotoUrl);
            builder.AddAttribute(2, "alt", fishCatch.FishName);
            builder.AddAttribute(3, "class", "catch-preview-img");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "class", "catch-preview-icon fs-icon-catches");
            builder.AddAttribute(6, "aria-hidden", "true");
            builder.CloseElement();
        }
    };

    private string FormatDateRange()
    {
        if (dashboard == null)
            return string.Empty;

        if (!dashboard.StartDate.HasValue)
            return $"jusqu'au {dashboard.EndDate:dd/MM/yyyy}";

        return $"{dashboard.StartDate.Value:dd/MM/yyyy} - {dashboard.EndDate:dd/MM/yyyy}";
    }

    private static string FormatBestCatch(FishCatch? fishCatch, string fallback)
    {
        return fishCatch == null ? fallback : fishCatch.FishName;
    }

    private static string FormatKg(double grams, string format = "0.00")
    {
        return $"{(grams / 1000.0).ToString(format, CultureInfo.CurrentCulture)} kg";
    }

    private static string FormatCm(double centimeters, string format = "0")
    {
        return $"{centimeters.ToString(format, CultureInfo.CurrentCulture)} cm";
    }

    private static string FormatNullable(double? value, string format, string unit)
    {
        return value.HasValue
            ? $"{value.Value.ToString(format, CultureInfo.CurrentCulture)} {unit}"
            : "Non renseigné";
    }

    private static string CountLabel(int count)
    {
        return count switch
        {
            0 => "Aucune prise",
            1 => "1 prise",
            _ => $"{count} prises"
        };
    }

    private static string BarWidthStyle(int value, int max)
    {
        var width = max <= 0 ? 0 : Math.Max(8, value * 100.0 / max);
        return $"--bar-width: {width.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private static string BarHeightStyle(int value, int max)
    {
        var height = max <= 0 ? 0 : Math.Max(8, value * 100.0 / max);
        return $"--bar-height: {height.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private static string HeatStyle(int value, int max)
    {
        var alpha = max <= 0 || value == 0 ? 0.06 : 0.18 + (value * 0.72 / max);
        return $"--heat-alpha: {alpha.ToString("0.##", CultureInfo.InvariantCulture)};";
    }

    private static string FormatMonth(MonthlyTrend trend)
    {
        return trend.MonthDate == default
            ? trend.Month
            : trend.MonthDate.ToString("MMM", CultureInfo.CurrentCulture);
    }

    private static string FormatSuggestionDate(DateTime date)
    {
        return date.ToString("ddd dd/MM HH:mm", CultureInfo.CurrentCulture);
    }

    private static string GetWeatherEmoji(int code)
    {
        return code switch
        {
            0 => "☀️",
            1 => "🌤️",
            2 => "⛅",
            3 => "☁️",
            45 or 48 => "🌫️",
            51 or 53 or 55 => "🌦️",
            61 or 63 or 65 => "🌧️",
            71 or 73 or 75 => "🌨️",
            77 => "🌨️",
            80 or 81 or 82 => "🌧️",
            85 or 86 => "🌨️",
            95 => "⛈️",
            96 or 99 => "⛈️",
            _ => "🌡️"
        };
    }

    private sealed class PeriodOption
    {
        public StatisticsPeriod Period { get; init; }
        public string Label { get; init; } = string.Empty;
    }
}
