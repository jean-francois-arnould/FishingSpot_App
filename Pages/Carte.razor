@page "/carte"
@page "/FishingSpot_App/carte"
@inject NavigationManager Navigation

<PageTitle>Carte des Spots</PageTitle>

<div class="page-content">
    <div class="feature-panel mb-3">
        <span class="list-item-icon fs-icon-map mb-3" aria-hidden="true"></span>
        <h1>Carte Géopêche</h1>
        <p class="text-muted mb-3">
            Explorez les spots de pêche autour de vous avec la carte interactive Géopêche.
        </p>
        <a href="https://map.geopeche.com/"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-primary btn-lg w-100">
            Ouvrir la carte Géopêche
        </a>
        <p class="text-muted mt-3 mb-0">
            La carte s'ouvrira dans un nouvel onglet.
        </p>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">À vérifier avant de partir</h5>
        </div>
        <div class="card-body">
            <ul class="feature-list">
                <li>Découvrir les spots publics près de chez vous</li>
                <li>Voir les espèces présentes dans chaque plan d'eau</li>
                <li>Consulter les avis et photos d'autres pêcheurs</li>
                <li>Vérifier les règlementations locales</li>
            </ul>
        </div>
    </div>
</div>
