@page "/"
@page "/FishingSpot_App/"
@using FishingSpot.PWA.Services
@using FishingSpot.PWA.Models
@inject IAuthService AuthService
@inject IUserProfileService ProfileService
@inject NavigationManager Navigation

<PageTitle>FishingSpot - Fishing Tracker</PageTitle>

@if (AuthService.IsAuthenticated)
{
    @if (isLoadingProfile)
    {
        <!-- Loading state -->
        <div class="empty-state">
            <div class="spinner"></div>
            <p class="mt-3">Chargement...</p>
        </div>
    }
    else
    {
        <!-- Utilisateur connecté -->
        <div class="home-hero">
            <div class="d-flex align-items-center gap-3">
                @if (userProfile != null && !string.IsNullOrEmpty(userProfile.AvatarUrl))
                {
                    <div class="profile-avatar-large">
                        <img src="@userProfile.AvatarUrl" alt="Avatar de @GetDisplayName()" />
                    </div>
                }
                else
                {
                    <span class="app-mark" aria-hidden="true"></span>
                }
                <div>
                    <span class="top-bar-kicker">Carnet de pêche</span>
                    <h1>Bienvenue @GetDisplayName()</h1>
                    <p>Préparez votre prochaine sortie et gardez vos prises à portée de main.</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Actions rapides</div>
            <div class="card-body quick-action-grid">
                <a href="/FishingSpot_App/catches/add" class="btn btn-primary btn-lg">
                    <span class="fs-icon fs-icon-plus" aria-hidden="true"></span>
                    Enregistrer une prise
                </a>
                <a href="/FishingSpot_App/catches" class="btn btn-outline-primary">
                    Voir mes prises
                </a>
                <a href="/FishingSpot_App/carte" class="btn btn-outline-primary">
                    Carte des spots
                </a>
                <a href="/FishingSpot_App/statistiques" class="btn btn-outline-primary">
                    Statistiques
                </a>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Raccourcis</div>
            <div class="card-body shortcut-grid">
                <a class="shortcut-card" href="/FishingSpot_App/materiel">
                    <span class="list-item-icon fs-icon-gear" aria-hidden="true"></span>
                    <span>
                        <span class="list-item-title d-block">Matériel</span>
                        <span class="list-item-subtitle d-block">Gérer votre équipement</span>
                    </span>
                    <span class="list-item-action">›</span>
                </a>

                <a class="shortcut-card" href="/FishingSpot_App/montages">
                    <span class="list-item-icon fs-icon-rig" aria-hidden="true"></span>
                    <span>
                        <span class="list-item-title d-block">Montages</span>
                        <span class="list-item-subtitle d-block">Vos configurations favorites</span>
                    </span>
                    <span class="list-item-action">›</span>
                </a>
            </div>
        </div>
    }
}
else
{
    <!-- Utilisateur non connecté -->
    <div class="home-hero">
        <span class="app-mark" aria-hidden="true"></span>
        <h1>FishingSpot</h1>
        <p>Suivez vos prises, vos lieux, vos photos et vos statistiques dans une PWA pensée pour mobile.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <h3 class="text-center mb-3">Commencez maintenant</h3>
            <p class="text-center mb-3">Créez un compte gratuit pour suivre vos prises de pêche.</p>
        <div class="quick-action-grid">
            <a href="/FishingSpot_App/register" class="btn btn-success btn-lg">
                Créer un compte
            </a>
            <a href="/FishingSpot_App/login" class="btn btn-outline-primary">
                Se connecter
            </a>
        </div>
        </div>
    </div>
}

@code {
    private UserProfile? userProfile;
    private bool isLoadingProfile = true;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            try
            {
                userProfile = await ProfileService.GetProfileAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading profile: {ex.Message}");
            }
            finally
            {
                isLoadingProfile = false;
            }
        }
        else
        {
            isLoadingProfile = false;
        }
    }

    private string GetDisplayName()
    {
        if (userProfile != null && !string.IsNullOrEmpty(userProfile.DisplayName))
        {
            return userProfile.DisplayName;
        }
        return AuthService.CurrentUser?.Email ?? "Pêcheur";
    }
}
